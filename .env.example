# Required
TELEGRAM_BOT_TOKEN=

# Storage. Without MONGO_URI, JSON files are written under DATA_DIR (mount it as a volume).
MONGO_URI=
MONGO_DB=fetchig
DATA_DIR=./data

# Optional: how the bot talks to Instagram (shared by all users)
IG_PROXY=
IG_DELAY_RANGE=1,3
IG_LOCALE=
IG_COUNTRY=
IG_COUNTRY_CODE=
IG_TIMEZONE_OFFSET=
IG_TLS_VERIFY=true
# Seconds allowed for story/highlight/audio downloads (instagrapi default is 25)
IG_READ_TIMEOUT=
# Proxy format: http://user:pass@host:port or socks5h://user:pass@host:port (use socks5h so DNS also goes through the proxy)
# Note: one IG_PROXY is shared by every connected account. Instagram trusts one stable IP per account most.

# Optional: limits
MAX_MEDIA_MB=50
MAX_WATCH=10
CODE_TIMEOUT=300
LOG_LEVEL=INFO

# Advanced, normally left empty (the library defaults are used)
# IG_APP_VERSION=
# IG_APP_VERSION_CODE=
# IG_BLOKS_VERSIONING_ID=
# IG_OVERRIDE_APP_VERSION=false
# IG_LEGACY_LOGIN=false
